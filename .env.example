# CTC-RAG local environment — copy to .env and fill in the Langfuse Cloud keys.
# .env is gitignored. These defaults are LOCAL-ONLY placeholders.

# ── practice-rag backend (Step 7) ──
# Ollama warm-up model (must be pulled on the host). Defaults to llama3.2:3b.
OLLAMA_WARMUP_MODEL=llama3.2:3b
# Frontend origin for CORS (Vite dev server).
FRONTEND_ORIGIN=http://localhost:5173
# Langfuse Cloud tracing keys — leave blank to disable tracing (structlog fallback).
# Create a free project at https://cloud.langfuse.com → Project Settings → API Keys.
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── NVIDIA NIM (optional, Phases 1+2+3 — comparison testing only) ──
# Set NIM_ENABLED=true to route generation (Phase 1) AND guardrails (Phase 2)
# through NIM with Ollama fallback. Guardrails use a 3-tier fallback:
# NIM nemoguard → Ollama judge → regex/keyword.
# Phase 3 (embeddings) is NOT wired into the live app — NIM embeddings
# populate a separate Qdrant collection (ctc_rag_nim) for recall@5
# comparison only. Run `run_nim_ingestion()` (also requires NIM_ENABLED=true)
# to populate it; the live app keeps using the Ollama docs-knowledge collection.
# Get a free API key at https://build.nvidia.com → Settings → API Keys.
# WARNING: free tier has no SLA, shared ~40 RPM rate limit, data egress to
# NVIDIA. Do NOT enable on corpora with real PII. See
# docs/NVIDIA_NIM_INTEGRATION_PLAN.md + docs/F500_ENTERPRISE_ACTION_ITEMS.md #8.
NIM_ENABLED=false
NVIDIA_API_KEY=
# NIM embedding model (Phase 3). Default: nvidia/llama-nemotron-embed-1b-v2.
# NIM_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
# NIM embedding dimensionality (Matryoshka: 384/512/768/1024/2048).
# Default 2048 (native). Changing this requires dropping + re-ingesting ctc_rag_nim.
# NIM_EMBEDDING_DIM=2048
